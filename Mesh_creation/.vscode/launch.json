{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
   "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch", // Puedes ponerle el nombre que quieras
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/mi_program", // ¡IMPORTANTE! Asegúrate que coincida con tu ejecutable
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}